class Solution:
    def largestInteger(self, nums: List[int], k: int) -> int:
        freq={}
        for num in nums:
            freq[num]=freq.get(num,0)+1
        count={}
        for i in range(len(nums)-k+1):
            subarray=set(nums[i:i+k])
            for num in subarray:
                count[num]=count.get(num,0)+1
        ans=-1
        for num in nums:
            if freq[num]==1 and count.get(num,0)==1:
                ans=max(ans,num)
        return ans

        

